# ==============================================================================
# KathakalAI Production Deployment Environment Template (.env.production)
# Location on VM: /home/sadm/KathakalAI/cd/.env.production
# ==============================================================================

# Database credentials (local PostgreSQL in Docker)
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=your_production_postgres_password
LOCAL_DB_NAME=culture_db

# MinIO credentials (local MinIO in Docker)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_production_minio_password

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Production uses OpenAI:
LLM_PROVIDER=openai
OPENAI_API_KEY=your_production_openai_api_key
OPENAI_MODEL=gpt-6-luna

# Fallbacks:
# SOCLAAS_API_KEY=your_soclaas_api_key
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_MODEL=default
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=openai/gpt-oss-120b
